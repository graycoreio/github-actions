{
  "version": 2,
  "functions": {
    "api/serverless.js": {
      "includeFiles": "{server/*.*,browser/{*.html,*.css},browser/**/*.json}",
      "runtime": "@vercel/node@1.8.5"
    }
  },
  "rewrites": [
    {
      "source": "/(.*[.].+)",
      "destination": "/browser/$1"
    },
    {
      "source": "/(.*)",
      "destination": "api/serverless"
    }
  ]
}