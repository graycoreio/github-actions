{
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "draft-pull-request": true,
  "prerelease": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "release-type": "node",
      "extra-files": [
        "README.md",
        "angular-universal-vercel/action.yml",
        "angular-universal-vercel/README.md",
        "angular-universal-vercel-wflw-run/README.md",
        "lighthouse-ci/README.md",
        "set-versions-from-root/README.md",
        "setup-node/README.md",
        "upload-algolia-index/README.md",
        "vercel/README.md"
      ]
    }
  }
}
